[Unit]
Description=Framework LED Monitor Daemon
After=multi-user.target network.target
Wants=multi-user.target

[Service]
Type=forking
ExecStart=/usr/local/bin/ledmonitord
ExecReload=/bin/kill -SIGUSR1 $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=10
TimeoutStopSec=30

# Security settings
User=framework
Group=dialout

# Resource limits
LimitNOFILE=1024
MemoryMax=128M
CPUQuota=25%


[Install]
WantedBy=multi-user.target
